# Database (PostgreSQL for production, SQLite for local dev)
# For production (Vercel Postgres, Neon, Supabase, etc.):
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# For local development only:
# DATABASE_URL="file:./dev.db"
# DIRECT_DATABASE_URL="file:./dev.db"

# JWT Secret (IMPORTANT: Generate a strong random string for production!)
# Use: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-here-CHANGE-THIS"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
# For production, use your domain: https://yourdomain.com

# IMPORTANT: Generate a strong random secret!
# Use: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-CHANGE-THIS"